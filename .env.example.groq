# Example .env Configuration for Multiple Groq API Keys
# Copy this to your .env file and replace with your actual keys

# ============================================================================
# Ollama Configuration
# ============================================================================
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
CREATIVE_LLM_MODEL=llama3.1:8b

# ============================================================================
# Groq API Keys (for LLM Judge)
# ============================================================================
# Get free API keys at: https://console.groq.com

# Primary API Key (Required)
GROQ_API_KEY=gsk_your_first_key_here

# Additional API Keys (Optional but Recommended)
# Add as many as you have to increase throughput
GROQ_API_KEY_2=gsk_your_second_key_here
GROQ_API_KEY_3=gsk_your_third_key_here
GROQ_API_KEY_4=gsk_your_fourth_key_here
GROQ_API_KEY_5=gsk_your_fifth_key_here

# Note: Each key has limits of:
# - 30 requests per minute
# - 1000 requests per day
# 
# With 5 keys, you can process up to 416 questions/day
# (5 keys × 1000 requests ÷ 12 evaluations per question)

# ============================================================================
# OpenAI (Optional - if you want to use OpenAI instead of Groq)
# ============================================================================
# OPENAI_API_KEY=sk-your_openai_key_here

# ============================================================================
# Anthropic (Optional - if you want to use Claude instead of Groq)
# ============================================================================
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ============================================================================
# MLflow
# ============================================================================
MLFLOW_TRACKING_URI=file:./mlruns

# ============================================================================
# Other Settings
# ============================================================================
# Add any other environment variables your project needs
